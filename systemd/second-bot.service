[Unit]
Description=second-bot

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/root/main/second_bot_main --nopva_detection --max_context=2 --ball_pathing_model=/root/gamepiece_models/ball_unet.engine --ball_cluster_radius_m=0.4
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
